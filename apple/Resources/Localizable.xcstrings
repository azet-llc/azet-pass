          "stringUnit": {
            "state": "translated",
            "value": "이 계정의 2단계 로그인"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントの2段階認証"
          }
        }
      }
    },
    "Two-step login is on": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "2단계 로그인이 켜져 있어요"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2段階認証はオンです"
          }
        }
      }
    },
    "Type": {
      "localizations": {
