            "state": "translated",
            "value": "약해요"
          }
        }
      }
    },
    "Weak passwords": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "약한 비밀번호"
          }
        }
      }
    },
    "Website": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "웹사이트"
          }
        }
      }
    },
    "Websites": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "웹사이트"
          }
        }
      }
    },
    "When someone turns on Travel Mode, only travel-safe vaults stay on their phone.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여행 모드를 켜면 여행용으로 표시한 금고만 휴대폰에 남아요."
          }
        }
      }
    },
    "Where it is kept": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관 장소"
          }
        }
      }
    },
    "While on, only items and vaults marked safe for travel stay on your devices. Everything else comes back when you turn it off.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜 두는 동안 여행용으로 표시한 항목과 금고만 기기에 남아요. 끄면 나머지가 모두 돌아와요."
          }
        }
      }
    },
    "Who can see it": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "볼 수 있는 가족"
          }
        }
      }
    },
    "Wi-Fi": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "와이파이"
          }
        }
      }
    },
    "Wi-Fi password": {
      "localizations": {
