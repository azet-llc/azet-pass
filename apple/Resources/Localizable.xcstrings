          }
        }
      }
    },
    "Two-step login available": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "2단계 로그인을 켤 수 있는 사이트"
          }
        }
      }
    },
    "Two-step login code. Scan the QR code the site shows, or paste its setup key.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "2단계 로그인 코드예요. 사이트의 QR 코드를 찍거나 설정 키를 붙여 넣으세요."
