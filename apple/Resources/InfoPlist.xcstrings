{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "CFBundleDisplayName": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AZET Pass"
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 비밀번호를 입력하는 대신 Face ID로 AZET Pass를 엽니다."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모장 한 쪽을 찍으면 AZET Pass가 적힌 로그인을 읽어요. 사진은 이 iPhone 밖으로 나가지 않아요."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모장 사진을 고르면 AZET Pass가 적힌 로그인을 읽어요. 사진은 이 iPhone 밖으로 나가지 않아요."
          }
        }
      }
    }
  }
}