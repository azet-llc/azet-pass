    "Version %@. Download it and replace this app.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버전 %@. 내려받아 이 앱을 바꿔 주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バージョン%@。ダウンロードして、このアプリと入れ替えてください。"
