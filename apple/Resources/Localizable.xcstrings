    "Add a login for this vault": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 금고에 로그인 추가"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この保管庫にログイン情報を追加"
          }
        }
      }
    },
    "Add logins to see your score": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인을 추가하면 점수가 나와요"
