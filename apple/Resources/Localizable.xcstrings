            "value": "보안 점수 %lld"
          }
        }
      }
    },
    "We mail you a link to make sure the address is yours.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주소가 맞는지 확인하려고 링크를 메일로 보내 드려요."
          }
        }
      }
    },
    "Weak": {
