# Upstream Bitwarden clients (GPL-3.0) that AZET Pass is built from. Latest stable and the one before (reference rule: open both).
CLIENTS_REPO=https://github.com/bitwarden/clients.git
BROWSER_TAG=browser-v2026.10.2
BROWSER_PREV_TAG=browser-v2026.10.1
# Browser extension version = upstream tag + AZET revision (stores need a higher version for each upload)
EXT_VERSION=${EXT_VERSION:-2026.10.2.1}
DESKTOP_TAG=desktop-v2026.10.4
DESKTOP_PREV_TAG=desktop-v2026.10.3
# our desktop version: upstream x.y.z becomes x.y.(z*100 + AZET build), so each AZET build is newer than the last and
# installed apps update to it by themselves (2026.10.4 build 2 = 2026.10.402; build 1 = the MS Store package)
DESKTOP_VERSION=2026.10.402
ANDROID_REPO=https://github.com/bitwarden/android.git
ANDROID_TAG=v2026.11.0-bwpm
# sdk-internal commit that tag asks for (gradle/libs.versions.toml: bitwardenSdk = "…-<commit>")
ANDROID_SDK_COMMIT=3b2c8fc3
IOS_REPO=https://github.com/bitwarden/ios.git
IOS_TAG=v2026.10.1-bwpm
# Bitwarden CLI (GPL-3.0), the OSS build (no bitwarden_license/), repackaged unchanged as the AZET Pass reader by
# clients/pack-reader.sh. CLI_BW_SHA256 = the bw binary inside the official bw-oss-macos-arm64-<ver>.zip.
CLI_TAG=cli-v2026.10.1
CLI_BW_SHA256=8360b8f7c2d214c1b2c6a52ab1c15472cbdab077a7f4688a929845e0362f6802
