          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロック解除"
          }
        }
      }
    },
    "Unlock AZET Pass": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AZET Pass 열기"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AZET Passのロックを解除"
          }
        }
      }
    },
    "Unlock AZET Pass first, then open the link again.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 AZET Pass를 연 다음 링크를 다시 눌러 주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先にAZET Passのロックを解除してから、もう一度リンクを開いてください。"
          }
        }
      }
    },
    "Unlock with Face ID": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID로 열기"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Face IDでロック解除"
          }
        }
      }
    },
    "Unlock with Touch ID": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch ID로 잠금 해제"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch IDでロック解除"
          }
        }
      }
    },
    "Unsecured websites": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보안 연결이 아닌 사이트"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全でない接続のサイト"
          }
        }
      }
    },
    "Up to 5 people, each with their own private vault, plus a Shared vault for the Wi-Fi, Netflix and everything the family uses together. As the family organizer you can help anyone who forgets their password.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "5명까지, 각자 개인 금고가 있고 와이파이·넷플릭스처럼 함께 쓰는 것은 가족 공유 금고에 둬요. 가족 관리자는 비밀번호를 잊은 가족을 도와줄 수 있어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "5人まで使えて、一人ひとりに専用の保管庫があります。Wi-FiやNetflixなど家族みんなで使うものは共有保管庫に入れておけます。家族の管理者は、パスワードを忘れた家族を手助けできます。"
          }
        }
      }
    },
    "Up to five people, each with a private vault": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다섯 명까지, 각자 개인 금고도 따로"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "5人まで、一人ひとりに専用の保管庫"
          }
        }
      }
    },
    "Use another account": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 계정 사용"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のアカウントを使う"
          }
        }
      }
    },
