        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 종이는 집 안 안전한 곳에 두세요. 이 종이와 비밀번호가 있으면 누구나 금고를 열 수 있어요."
          }
        }
      }
    },
