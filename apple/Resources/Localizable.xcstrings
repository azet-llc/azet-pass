    "Two-step login available": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증 코드를 켤 수 있는 사이트"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2段階認証を使えるサイト"
