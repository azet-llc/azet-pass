        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン情報を追加するとスコアが表示されます"
          }
        }
      }
    },
    "Add more": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목 더 추가"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "さらに追加"
          }
        }
      }
    },
    "Add this key to an authenticator app (not AZET Pass itself), then type the 6-digit code it shows.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 키를 인증 앱(AZET Pass 말고 다른 앱)에 넣고, 나오는 6자리 코드를 입력하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このキーを認証アプリ（AZET Pass以外）に登録して、表示された6桁のコードを入力してください。"
          }
        }
      }
    },
